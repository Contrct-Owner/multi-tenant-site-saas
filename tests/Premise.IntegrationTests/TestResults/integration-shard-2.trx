      );
      CREATE INDEX idx_wolverine_dead_letters_replayable ON wolverine.wolverine_dead_letters USING btree (replayable) WHERE (replayable = true);
      CREATE TABLE IF NOT EXISTS wolverine.wolverine_nodes (
