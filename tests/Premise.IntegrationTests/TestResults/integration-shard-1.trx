info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@ef_filter__CurrentOrg='?' (DbType = Guid), @ef_filter__CurrentOrg0='?' (DbType = Guid), @userId='?' (DbType = Guid), @org='?' (DbType = Guid), @domain='?', @verb='?'], CommandType='Text', CommandTimeout='30']
      SELECT DISTINCT m1.scope_path
      FROM identity.memberships AS m
      INNER JOIN (
          SELECT m0.membership_id, m0.role_id, m0.scope_path
          FROM identity.membership_roles AS m0
          WHERE m0.org_id = @ef_filter__CurrentOrg
      ) AS m1 ON m.id = m1.membership_id
      INNER JOIN (
          SELECT r.action, r.domain, r.role_id
          FROM identity.role_grants AS r
          WHERE r.org_id = @ef_filter__CurrentOrg0
      ) AS r0 ON m1.role_id = r0.role_id
      WHERE m.user_id = @userId AND m.org_id = @org AND (r0.domain = @domain OR r0.domain = '*') AND (r0.action = @verb OR r0.action = '*')
