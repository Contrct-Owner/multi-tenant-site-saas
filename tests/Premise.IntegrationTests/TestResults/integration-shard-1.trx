      SELECT DISTINCT g.scope_path
      FROM identity.grant_exceptions AS g
      WHERE g.org_id = @ef_filter__CurrentOrg AND g.user_id = @userId AND g.org_id = @org AND g.expires_at &gt; @now AND (g.domain = @domain OR g.domain = '*') AND (g.action = @verb OR g.action = '*')
