      CREATE TABLE IF NOT EXISTS wolverine.wolverine_outgoing_envelopes (
          id              uuid                        NOT NULL,
          owner_id        integer                     NOT NULL,
          destination     varchar                     NOT NULL,
          deliver_by      timestamp with time zone    NULL,
