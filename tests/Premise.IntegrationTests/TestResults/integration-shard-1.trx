info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (71ms) [Parameters=[@ef_filter__CurrentOrg='?' (DbType = Guid), @org='?' (DbType = Guid), @code='?', @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT e.value
      FROM entitlements.entitlement_exceptions AS e
      WHERE e.org_id = @ef_filter__CurrentOrg AND e.org_id = @org AND e.code = @code AND e.expires_at &gt; @now
      ORDER BY e.created_at DESC
      LIMIT 1
